# Copy to .env.local for development. Never commit real values.

# --- Public site configuration (safe to expose; shown on the site only when set) ---
NEXT_PUBLIC_SITE_URL=https://continentaviation.in
NEXT_PUBLIC_CONTACT_EMAIL=charters@continentaviation.in
NEXT_PUBLIC_CONTACT_PHONE=
# Digits only with country code, e.g. 91XXXXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_BUSINESS_HOURS=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
# Privacy-friendly analytics (Plausible domain). Leave empty to disable.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# --- Server-only: enquiry delivery (never prefix with NEXT_PUBLIC_) ---
# Option 1: Resend (https://resend.com) transactional email
RESEND_API_KEY=
# Verified sender on your Resend domain, e.g. "Continent Aviation <enquiries@yourdomain.com>"
ENQUIRY_FROM_EMAIL=
# Inbox(es) that receive enquiries, comma-separated
ENQUIRY_TO_EMAIL=

# Option 2 (can be used with or instead of Option 1): CRM / automation webhook
# Receives a JSON POST of each validated enquiry (Zapier, Make, HubSpot forms API proxy, etc.)
ENQUIRY_WEBHOOK_URL=
# Optional bearer token sent to the webhook as "Authorization: Bearer <token>"
ENQUIRY_WEBHOOK_SECRET=

# --- Server-only: database, admin and quotes ---
# Postgres connection string (Neon, Supabase, Vercel Postgres, etc.). REQUIRED in production for the
# enquiry list, admin console, quotes and route alerts. In development, leave empty to use an embedded
# local database stored in .data/ (set PGLITE_DIR=memory to keep nothing on disk).
DATABASE_URL=
PGLITE_DIR=
# The only address allowed to sign in to /admin (magic link is emailed here). Defaults to the contact email.
ADMIN_EMAIL=charters@continentaviation.in
# Signs the admin session cookie. At least 24 random characters, e.g. `openssl rand -base64 32`.
SESSION_SECRET=
# Authorises the daily expiry job (/api/cron/expire). Vercel sends it as "Authorization: Bearer <value>".
CRON_SECRET=
# How long a private quote stays open, in hours.
QUOTE_VALID_HOURS=48
